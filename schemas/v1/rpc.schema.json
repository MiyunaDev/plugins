{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.miyunadev.org/schemas/v1/rpc.schema.json",
  "title": "MiyunaCapabilityBrokerRPC",
  "description": "JSON-RPC 2.0 protocol schemas for Miyuna Capability Broker host-plugin communication.",
  "oneOf": [
    { "$ref": "#/$defs/Request" },
    { "$ref": "#/$defs/Notification" },
    { "$ref": "#/$defs/SuccessResponse" },
    { "$ref": "#/$defs/ErrorResponse" }
  ],
  "$defs": {
    "RequestId": {
      "type": ["string", "number"],
      "description": "Unique identifier for request-response correlation."
    },
    "ErrorCode": {
      "type": "integer",
      "description": "Standard JSON-RPC 2.0 and Miyuna broker specific error codes.",
      "enum": [
        -32700,
        -32600,
        -32601,
        -32602,
        -32603,
        -32001,
        -32002,
        -32003,
        -32004,
        -32005,
        -32006
      ]
    },
    "Request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": { "$ref": "#/$defs/RequestId" },
        "method": {
          "type": "string",
          "enum": [
            "broker.getCapabilities",
            "broker.invoke",
            "broker.subscribe",
            "broker.unsubscribe",
            "broker.publish"
          ]
        },
        "params": {
          "type": "object"
        }
      }
    },
    "Notification": {
      "type": "object",
      "required": ["jsonrpc", "method"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "method": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)+$"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "SuccessResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": { "$ref": "#/$defs/RequestId" },
        "result": {}
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "additionalProperties": false,
      "properties": {
        "jsonrpc": {
          "type": "string",
          "const": "2.0"
        },
        "id": {
          "type": ["string", "number", "null"]
        },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "additionalProperties": false,
          "properties": {
            "code": { "$ref": "#/$defs/ErrorCode" },
            "message": { "type": "string" },
            "data": {}
          }
        }
      }
    }
  }
}
