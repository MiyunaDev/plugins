{
  "$schema": "https://specs.miyunadev.org/schemas/v1/plugin.schema.json",
  "id": "org.miyunadev.games.retro-runner",
  "name": "Retro Runner Arcade",
  "version": "0.9.5",
  "description": "An 8-bit endless runner mini-game playable offline in Miyuna clients.",
  "author": {
    "name": "Arcade Studio"
  },
  "engines": {
    "miyuna": ">=1.0.0"
  },
  "artifact": {
    "type": "web-bundle",
    "entry": "dist/game.html"
  },
  "contributions": [
    {
      "type": "route",
      "id": "runner-game-route",
      "title": "Retro Runner",
      "path": "/ext/games/runner"
    }
  ],
  "capabilities": [
    {
      "name": "storage.local",
      "quota": "5MB"
    },
    {
      "name": "ui.canvas"
    }
  ]
}
