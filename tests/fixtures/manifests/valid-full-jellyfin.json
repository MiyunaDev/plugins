{
  "$schema": "https://specs.miyunadev.org/schemas/v1/plugin.schema.json",
  "id": "org.miyunadev.plugins.jellyfin-connector",
  "name": "Jellyfin Media Connector",
  "version": "1.2.0-beta.1",
  "description": "Stream media from a personal self-hosted Jellyfin server directly inside Miyuna clients.",
  "author": {
    "name": "Media Team",
    "email": "media@miyunadev.org",
    "url": "https://miyunadev.org"
  },
  "license": "MIT",
  "homepage": "https://github.com/miyuna/jellyfin-connector",
  "icon": "assets/icon.png",
  "engines": {
    "miyuna": ">=1.0.0",
    "client": {
      "web": true,
      "android": ">=2.0.0",
      "ios": true
    }
  },
  "artifact": {
    "type": "web-bundle",
    "entry": "dist/index.html",
    "integrity": "sha256-47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU="
  },
  "contributions": [
    {
      "type": "route",
      "id": "jellyfin-library",
      "title": "Jellyfin Server",
      "path": "/ext/jellyfin",
      "icon": "assets/jellyfin.png"
    },
    {
      "type": "widget",
      "id": "jellyfin-quick-resume",
      "title": "Continue Watching (Jellyfin)",
      "slot": "dashboard-card"
    }
  ],
  "capabilities": [
    {
      "name": "storage.local",
      "reason": "Stores user server URL and view preferences.",
      "quota": "15MB"
    },
    {
      "name": "network.fetch",
      "reason": "Queries Jellyfin server APIs for video catalog and playback.",
      "domains": ["*"]
    },
    {
      "name": "auth.secureKeyring",
      "reason": "Securely stores user Jellyfin auth token."
    }
  ],
  "dependencies": {
    "org.miyunadev.plugins.media-player-helper": "^1.0.0"
  }
}
